<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="okno.MainWindow"
        Title="Warsztat Narzędziowy"
        Width="500" Height="550"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E">
    <StackPanel Margin="20" Spacing="15" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="Warsztat Narzędziowy" FontSize="26" FontWeight="Bold" Foreground="#CDD6F4" HorizontalAlignment="Center"/>
        <TextBlock Text="Stanowisko diagnostyczne aktywne" FontSize="13" Foreground="#A6ADC8" HorizontalAlignment="Center"/>
        <TextBox x:Name="RepairNameInput" Watermark="Wpisz nazwę naprawy lub sprzętu..." Width="360" HorizontalAlignment="Center"/>
        <Button x:Name="AddOrderButton" Content="Dodaj zlecenie" Click="OnAddOrderClicked" Background="#89B4FA" Foreground="#11111B" CornerRadius="8" Padding="15,8" HorizontalAlignment="Center" FontWeight="SemiBold"/>
        <ListBox x:Name="OrdersList" Width="360" Height="130" Background="#313244" CornerRadius="8"/>
        <Button x:Name="RemoveOrderButton" Content="Zakończ wybrane zlecenie" Click="OnRemoveOrderClicked" Background="#F38BA8" Foreground="#11111B" CornerRadius="8" Padding="12,6" HorizontalAlignment="Center" FontWeight="SemiBold"/>
        <TextBlock x:Name="CounterLabel" Text="Liczba zleceń w toku: 0" FontSize="13" Foreground="#94E2D5" HorizontalAlignment="Center"/>
    </StackPanel>
</Window>
